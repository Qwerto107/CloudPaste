# 第一次启动前填写至少 12 字节的管理员密码；不要提交实际 .env 文件。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 默认仅监听宿主机回环地址，供宿主机 HTTPS 反向代理转发。
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081

# 使用 GHCR 预构建镜像时填写完整名称及相同版本标签；留空则本地构建。
# GO_BACKEND_IMAGE=ghcr.io/qwerto107/cloudpaste-backend:0.2.0
# GO_FRONTEND_IMAGE=ghcr.io/qwerto107/cloudpaste-frontend:0.2.0

# 文件目录；Linux 上请确保 UID 65532 可以读写。只需浏览时设为 true。
LOCAL_FILES_DIR=./files
LOCAL_FILES_READ_ONLY=false

# 这是 Go GC 的软目标，容器上限由 compose 的 mem_limit 控制。
GOMEMLIMIT=80MiB
MAX_DOWNLOADS=8
# 上传使用固定内存缓冲；临时文件保存在持久数据卷。大小单位 MiB。
MAX_UPLOADS=2
MAX_UPLOAD_SIZE_MB=100
MAX_STAGED_SIZE_MB=1024
