# 第一次启动前填写至少 12 字节的管理员密码；不要提交实际 .env 文件。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 默认仅监听宿主机回环地址，供宿主机 HTTPS 反向代理转发。
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081

# 使用 GHCR 预构建镜像时填写完整名称及相同版本标签；留空则本地构建。
# GO_BACKEND_IMAGE=ghcr.io/qwerto107/cloudpaste-backend:0.6.1
# GO_FRONTEND_IMAGE=ghcr.io/qwerto107/cloudpaste-frontend:0.6.1
# 使用 docker-compose.standalone.yml 时只需填写合并镜像。
# GO_STANDALONE_IMAGE=ghcr.io/qwerto107/cloudpaste-standalone:0.6.1

# 文件目录；Linux 上请确保 UID 65532 可以读写。只需浏览时设为 true。
LOCAL_FILES_DIR=./files
LOCAL_FILES_READ_ONLY=false

# 这是 Go GC 的软目标，容器上限由 compose 的 mem_limit 控制。
GOMEMLIMIT=80MiB
MAX_DOWNLOADS=8
# 二进制部署默认不信任转发头；只填写受信代理 IP/CIDR 或由可信 DNS 管理的主机名。
# 分离版 Compose 固定信任内部 frontend 服务；合并版通过本变量配置可信外部代理。
# TRUSTED_PROXIES=127.0.0.1,::1
# 上传使用固定内存缓冲；临时文件保存在持久数据卷。大小单位 MiB。
MAX_UPLOADS=2
MAX_UPLOAD_SIZE_MB=100
MAX_STAGED_SIZE_MB=1024

# 设备互传：授权用户创建，访客凭短期配对码加入，不依赖文件存储。
# 中继与网站共用端口；默认四个并发请求，可在管理后台“设备互传”中调整。
TRANSFER_ENABLED=true
TRANSFER_MAX_FILE_MB=10240
# 首次默认限速；0 为不限速，后台保存的速率设置优先于此值。
TRANSFER_RATE_MB=64
# 可选 STUN 地址，用于跨网络直连；留空时只尝试本地候选，失败可用 HTTPS 中继。
# TRANSFER_STUN=stun:your-stun-server.example:3478
