# 容器部署时保存为运行目录的 .env；密码至少 6 个字符、最多 72 字节，不要提交实际配置。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 镜像版本和端口直接在对应 Compose 文件中修改。

# 文件目录；Linux 上请确保 UID 65532 可以读写 ./data 与文件目录。
# 只需浏览文件时设为 true，不影响 ./data 的读写。
LOCAL_FILES_DIR=./files
LOCAL_FILES_READ_ONLY=false

# 这是 Go GC 的软目标，容器上限由 compose 的 mem_limit 控制。
GOMEMLIMIT=80MiB
# 普通文件下载并发，范围 1–65535，默认 48。
MAX_DOWNLOADS=48
# 二进制部署默认不信任转发头；只填写受信代理 IP/CIDR 或由可信 DNS 管理的主机名。
# 分离版 Compose 固定信任内部 frontend 服务；合并版通过本变量配置可信外部代理。
TRUSTED_PROXIES=
# 上传使用固定内存缓冲；临时文件保存在持久数据卷。大小单位 MiB。
# 普通文件上传并发，范围 1–65535，默认 16。
MAX_UPLOADS=16
MAX_UPLOAD_SIZE_MB=10240
MAX_STAGED_SIZE_MB=20480

# 设备互传：授权用户创建，访客凭短期配对码加入，不依赖文件存储。
# 中继与网站共用端口；默认 64 路并发，可在管理后台“设备互传”中调整。
TRANSFER_ENABLED=true
TRANSFER_MAX_FILE_MB=10240
# 首次默认限速；0 为不限速，后台保存的速率设置优先于此值。
TRANSFER_RATE_MB=64
# 可选 STUN 地址，格式 stun:主机:端口；留空时只尝试本地候选，失败可用 HTTPS 中继。
TRANSFER_STUN=

# 每分钟限频：留空或不配置时使用以下默认值，整数范围 1–1000000。
# 密码验证的管理/访客入口独立计数；中继上传与下载共享同一 IP 的次数。
PASSWORD_ATTEMPTS_PER_MINUTE=10
TRANSFER_CREATE_PER_MINUTE=30
TRANSFER_JOIN_PER_MINUTE=30
TRANSFER_RELAY_PER_MINUTE=180
TRANSFER_WS_CONNECT_PER_MINUTE=30
# 消息按已认证成员计数；互传来源为 IPv6 时按 /64 聚合。
TRANSFER_WS_MESSAGES_PER_MINUTE=240
TRANSFER_TOOL_PER_MINUTE=240
# 已授权文件夹内部操作独立计数，不与普通消息和中继共享额度。
TRANSFER_FOLDER_WS_MESSAGES_PER_MINUTE=12000
TRANSFER_FOLDER_RELAY_PER_MINUTE=12000

# 同源部署留空；前后端异源时填写浏览器页面的 Origin，多个值用逗号分隔。
ALLOWED_ORIGINS=

# 留空时在 ./data/encryption.key 自动生成并保存密钥。
# 自定义值必须是 32 字节随机数据的 Base64 编码；保存数据后不要随意更换。
ENCRYPTION_SECRET=

# 容器内 DATA_DIR=/data、PORT=8787 由 Compose 固定，不在这里覆盖。
