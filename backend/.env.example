# 管理员首次初始化使用；已有账号在后台修改，实际配置不要提交。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 文件目录由容器挂载决定；Linux 上需授权 UID/GID 65532 读写。
LOCAL_FILES_DIR=./files
LOCAL_FILES_READ_ONLY=false

# Go GC 软目标，容器内存上限仍由 Compose 的 mem_limit 控制。
GOMEMLIMIT=80MiB

# 只信任实际反向代理 IP、CIDR 或主机名；直连留空。
# 分离版 Compose 固定信任内部 frontend；单容器使用此值。
TRUSTED_PROXIES=

# 同源部署留空；异源部署填写页面 Origin，多个值用逗号分隔。
ALLOWED_ORIGINS=

# 留空自动生成并保存 data/encryption.key，已有数据不要更换密钥。
ENCRYPTION_SECRET=

# 上传、下载、暂存额度、设备互传及限频统一在管理后台设置。
# 原 MAX_*、TRANSFER_*、PASSWORD_ATTEMPTS_PER_MINUTE 环境变量不再生效。
# 容器内 DATA_DIR=/data、PORT=8787 由 Compose 固定。
